# ==================================================================
# 环境变量 —— 复制为 .env 后填写真实值
#   复制命令： cp .env.example .env      (Windows: Copy-Item .env.example .env)
#
# 本项目所有入口（API 服务、建表脚本、填充脚本）都会自动读取这里的 .env，
# 也兼容放在 apps/api/.env；两处同时存在时以本文件为准。
# ==================================================================

# ------------------------------------------------------------------
# 数据库（必填）
# ------------------------------------------------------------------
# PostgreSQL 连接串。推荐 Neon（免费版无需信用卡）：
#   1. 访问 https://neon.tech 注册并创建项目
#   2. 在 Dashboard 复制 Connection string
#   3. 粘贴到下方
#
# Supabase 同样可用，但请使用 Connection Pooling（端口 6543）的连接串。
#
# 注意：如果你要部署到 Cloudflare Workers，必须使用 Neon 或其它支持 HTTP 的
# Postgres 服务——Workers 环境无法建立 TCP 连接。
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------
# 会话密钥（必填，至少 16 字符）
# ------------------------------------------------------------------
# 用于签发 JWT 登录令牌。泄露等于任何人都能伪造管理员身份，务必随机生成，
# 且不要与任何代码一起提交到 Git。
#
# 生成方式（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
AUTH_SECRET=请替换为随机字符串至少32位

# ------------------------------------------------------------------
# 跨域来源（前后端分开部署时必填）
# ------------------------------------------------------------------
# 前端域名。多个域名用英文逗号分隔。
# 本地开发填 http://localhost:5173
# 生产环境填你的站点域名，如 https://school.example.com
#
# 若前端与 API 同域部署（如都放在 Vercel 同一项目），可留空。
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# 图片存储（可选，默认无需任何配置）
# ------------------------------------------------------------------
# dataurl = 图片转 base64 直接存数据库，零配置、零成本，Vercel 与 Cloudflare
#           均可直接使用，无需 R2 等需要绑定信用卡的服务。默认值。
# s3      = 使用兼容 S3 协议的对象存储（Backblaze B2 有免费额度且无需信用卡、
#           也可用 MinIO 自建）
STORAGE_DRIVER=dataurl

# 仅当 STORAGE_DRIVER=s3 时需要填写以下全部字段
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# S3_REGION=us-west-004
# S3_BUCKET=my-school-bucket
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 图片的公开访问基址（B2 的公开桶地址或自定义域名）
# S3_PUBLIC_BASE_URL=https://my-school-bucket.s3.us-west-004.backblazeb2.com
