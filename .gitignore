# 依赖
node_modules/
.pnpm-store/

# 只保留仓库根的 package-lock.json（npm workspaces 统一管理），
# 子包内的 lock 文件是多余的且会干扰 Vercel 上的 workspace 解析
packages/*/package-lock.json
apps/*/package-lock.json

# 构建产物
dist/
.output/
.vercel/
.wrangler/
*.tsbuildinfo

# 环境变量（切勿提交真实密钥）
.env
.env.local
.env.*.local
!.env.example

# 本地数据库 / 上传文件
data/
apps/api/.dev.vars

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
