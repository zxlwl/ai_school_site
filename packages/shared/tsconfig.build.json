  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "Node",
    "module": "ESNext",
    "verbatimModuleSyntax": false,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
